# Eval scenario runtime (regenerated by setup.sh / produced by the agent under test).
# RESULTS.md is intentionally NOT ignored — recorded runs stay tracked.
evals/scenarios/*/state/
evals/scenarios/*/env.sh
evals/scenarios/*/check.out

# Generated eval materials and agent transcripts.
evals/runs/
evals/scenarios/*/transcript*.txt
evals/scenarios/*/transcript*.jsonl
evals/scenarios/*/bad-transcript.txt
evals/scenarios/S03/haystack.log
evals/scenarios/S08/port.txt
evals/scenarios/S10/token.txt

# M-suite manual-run artifacts (regenerated by setup.sh / produced by agents).
evals/scenarios/*/subgoals.json
evals/scenarios/*/setup.log
evals/scenarios/*/golden.log
evals/scenarios/*/check-*.log
evals/scenarios/M*/answer-*.txt
evals/scenarios/M*/DONE.txt
evals/scenarios/M*/.mig-config
evals/scenarios/M01/noisy.log
evals/scenarios/M01/server-port.txt
evals/scenarios/M01/server.log
evals/scenarios/M01/test-report.txt
evals/scenarios/M03/handoff.json
evals/scenarios/M03/handoff-seen.txt
evals/scenarios/M03/human-note.txt
evals/scenarios/M03/sidework-a.txt
evals/scenarios/M03/sidework-b.txt
evals/scenarios/M03/migration-done.txt
evals/scenarios/M07/build-out.txt

# Python test/runtime caches.
__pycache__/
*.py[cod]

# OS / editor cruft
.DS_Store
*.swp
